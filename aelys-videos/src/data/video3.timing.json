    {
     "id": "p3_3_1",
     "t0": 0.0,
     "t1": 10.5,
     "vo": "Pour une enveloppe bulle, vous avez besoin : de l'enveloppe, d'un écrin web Aélys ou de l'écrin de la marque, d'un porte-facture et du livret « Merci pour votre commande ».",
     "cues": [
      {
       "phrase": "enveloppe",
       "action": "l'enveloppe est entourée",
       "t": 3.403
      },
      {
       "phrase": "écrin",
       "action": "l'écrin est entouré",
       "t": 4.764
      },
      {
       "phrase": "porte-facture",
       "action": "le porte-facture est entouré",
       "t": 7.825
      },
      {
       "phrase": "livret",
       "action": "le livret est entouré",
       "t": 8.919
      }
     ]
    },
    {
     "id": "p3_3_4",
     "t0": 10.5,
     "t1": 20.5,
     "vo": "Placez le bijou dans l'écrin, mettez le bon de livraison et le livret « Merci » à l'intérieur du porte-facture et glissez le tout dans l'enveloppe.",
     "cues": [
      {
       "phrase": "bijou",
       "action": "le bijou est placé dans l'écrin",
       "t": 12.606
      },
      {
       "phrase": "bon de livraison",
       "action": "le bon et le livret entrent dans le porte-facture",
       "t": 14.25
      },
      {
       "phrase": "glissez",
       "action": "le tout est glissé dans l'enveloppe",
       "t": 17.933
      }
     ]
    },
    {
     "id": "p3_3_5",
     "t0": 20.5,
     "t1": 26.5,
     "vo": "Retirez la bande de protection de l'adhésif puis fermez l'enveloppe.",

{
  "name": "aelys-videos",
  "version": "0.1.0",
  "private": true,
  "description": "Vidéos de formation Aélys : commandes internet (Remotion)",
  "scripts": {
    "dev": "remotion studio src/index.ts",
    "render:v1": "remotion render src/index.ts Video1 out/video1.mp4 --codec=h264 --crf=18",
    "render:v2": "remotion render src/index.ts Video2 out/video2.mp4 --codec=h264 --crf=18",
    "render:v3": "remotion render src/index.ts Video3 out/video3.mp4 --codec=h264 --crf=18",
    "still:v1": "remotion still src/index.ts Video1 out/still.png",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@fontsource/montserrat": "^5.1.0",
    "@remotion/cli": "4.0.290",
    "@remotion/fonts": "4.0.290",
    "@remotion/transitions": "4.0.290",
    "lucide-react": "^0.460.0",
    "react": "18.3.1",
    "react-dom": "18.3.1",
    "remotion": "4.0.290"
  },
  "devDependencies": {
    "@types/react": "18.3.12",
    "typescript": "5.6.3"
  }
}
